# --- Frontend dev image: Vite dev server with hot reload ---
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Source is mounted as a volume in docker-compose.yml, so we don't COPY it here.
# This keeps rebuilds fast and hot-reload working.

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host"]